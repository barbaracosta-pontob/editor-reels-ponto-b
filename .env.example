# Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Modelo Claude usado para análise de transcrição → cenas
CLAUDE_MODEL=claude-sonnet-4-6

# faster-whisper
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto
# auto | cpu | cuda

# Pasta onde os jobs são persistidos (pode apontar pra disco externo se quiser)
JOBS_DIR=./jobs

# Porta do Next.js
# Pra abrir varias instancias locais em paralelo, so clicar no atalho
# start-instance.bat (ou rodar "npm run dev:instance") de novo a cada vez.
# Cada clique detecta a proxima porta livre (3000, 3001, 3002...) e usa
# um JOBS_DIR isolado automaticamente. Nada pra digitar.
PORT=3000
