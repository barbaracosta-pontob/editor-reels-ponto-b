# Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Modelo Claude usado para análise de transcrição → cenas
CLAUDE_MODEL=claude-sonnet-4-6

# faster-whisper
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto
# auto | cpu | cuda

# Pasta onde os jobs são persistidos (pode apontar pra disco externo se quiser)
JOBS_DIR=./jobs

# Porta do Next.js
# Pra abrir varias instancias locais em paralelo, so clicar no atalho
# start-instance.bat (ou rodar "npm run dev:instance") de novo a cada vez.
# Cada clique detecta a proxima porta livre (3000, 3001, 3002...) e usa
# um JOBS_DIR isolado automaticamente. Nada pra digitar.
PORT=3000

PEXELS_API_KEY=sua_chave_pexels_aqui

# --- Ajustes de performance (todos opcionais) -------------------------------
# Medidos na maquina "babi" (i3-8145U, 2 nucleos / 4 threads, UHD 620, sem GPU
# NVIDIA). Numa maquina diferente vale remedir antes de copiar valores.

# Abas do Chromium renderizando frames em paralelo. Vazio = metade dos nucleos
# logicos (piso 1, teto 4). Num i3 de 2 nucleos fisicos, 2 e o teto util.
# REMOTION_CONCURRENCY=2

# Renderizador do Chromium. Default headless e swangle = rasterizacao por
# software na CPU. "angle" passa para a GPU integrada e libera CPU.
# Testar e comparar o fps no log antes de adotar.
# REMOTION_GL=angle

# Threads de computacao do CTranslate2 na transcricao. Vazio = metade dos
# nucleos logicos, piso 4 (que e o proprio default do CTranslate2).
# WHISPER_CPU_THREADS=4

# beam_size do Whisper. Default 5. Em CPU fraca, 1 (greedy) corta ~40% do tempo
# com perda pequena em audio limpo de estudio.
# WHISPER_BEAM_SIZE=1
